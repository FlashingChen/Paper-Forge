# 复制为 .env。实际配置、密钥及运行数据不要提交。
# 登录与管理员：SESSION_SECRET 使用 openssl rand -base64 32 生成。
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_QUOTA=100000

# 模型：填写自己的接口和实际支持图片及工具调用的模型。
# 后台保存的配置优先于这里。
PAPERFORGE_PROVIDER=
PAPERFORGE_BASE_URL=
PAPERFORGE_MODEL=
PAPERFORGE_API_KEY=

# 本地验证使用 local；公开服务采用 node 和隔离任务容器。
PAPERFORGE_EXECUTOR=local
PAPERFORGE_DISPATCH_ENABLED=1
PAPERFORGE_JOBS_DIR=./.jobs
PAPERFORGE_TIMEOUT_MS=1800000
PAPERFORGE_MAX_IMAGES=20
PAPERFORGE_IMAGE_MAX_EDGE=1568
PAPERFORGE_IMAGE_MAX_BYTES=262144
PAPERFORGE_IMAGE_JPEG_QUALITY=75
# 启动前 export PAPERFORGE_PYTHON="$PWD/.venv/bin/python"
# PAPERFORGE_DB_PATH=
# PAPERFORGE_PI_BIN=

# 节点模式：独立随机执行密钥至少 32 字符。
PAPERFORGE_EXECUTION_SECRET=
PAPERFORGE_CONTROL_URL=
PAPERFORGE_MODEL_GATEWAY_URL=
PAPERFORGE_MODEL_ALLOWED_ORIGINS=
# PAPERFORGE_NODES=[{"id":"node-1","tokenHash":"<SHA256_HEX>","concurrency":1}]
# 节点管理器的配置单独保存，不发送给任务 Agent。
# PAPERFORGE_NODE_ID=node-1
# PAPERFORGE_NODE_TOKEN=
# PAPERFORGE_AGENT_IMAGE=
# PAPERFORGE_NODE_VOLUME=
# PAPERFORGE_NODE_SCOPE=beta
# PAPERFORGE_NODE_CONCURRENCY=1
# PAPERFORGE_AGENT_MEMORY_MB=2048
# PAPERFORGE_AGENT_CPUS=1

# 可选的公开联系标签和站内赞助图片路径；默认不展示收款码。
NEXT_PUBLIC_BETA_CONTACT=
NEXT_PUBLIC_COFFEE_WECHAT_QR=
NEXT_PUBLIC_COFFEE_ALIPAY_QR=
